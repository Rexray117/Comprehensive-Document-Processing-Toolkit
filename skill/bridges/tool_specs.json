          },
          "header_row": {
            "type": "integer",
            "description": "表头所在行（默认 1；0 表示无表头）"
          },
          "max_rows": {
            "type": "integer",
            "description": "每张表最多返回的数据行数（默认 500）"
          },
          "max_cols": {
            "type": "integer",
            "description": "每张表最多返回的列数（默认 100）"
          },
          "mode": {
            "type": "string",
            "description": "values（默认，优先缓存值）| formulas | both"
          },
          "include_formulas": {
            "type": "boolean",
            "description": "是否附带公式明细（默认 true）"
          }
        },
        "required": [
          "input"
        ]
      },
      "_meta": {
        "module": "xlsx",
        "action": "read"
      }
    },
    {
      "name": "file_xlsx_analyze",
      "description": "[XLSX 工作表] 数据分析：描述统计、缺失率、唯一值、重复行、相关性、分组聚合、离群点",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "输入文件的绝对路径"
          },
          "output": {
            "type": "string",
            "description": "输出目录或文件路径（可选）"
          },
          "sheet": {
            "type": "string",
            "description": "工作表名或索引（默认第一张）"
          },
          "header_row": {
            "type": "integer",
            "description": "表头所在行（默认 1）"
          },
          "by": {
            "type": "string",
            "description": "分组聚合的分组列名（可选）"
          },
          "agg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array"
              }
            ],
            "description": "分组聚合方式，如 sum,mean,count（默认 sum,mean,count）"
          },
          "top_n": {
            "type": "integer",
            "description": "每列 Top 值个数（默认 5）"
          },
          "corr": {
            "type": "boolean",
            "description": "是否输出数值列相关性（默认 true）"
          },
          "sample_rows": {
            "type": "integer",
            "description": "预览行数（默认 8）"
          }
        },
        "required": [
          "input"
        ]
      },
      "_meta": {
        "module": "xlsx",
        "action": "analyze"
      }
    },
    {
      "name": "file_xlsx_transform",
      "description": "[XLSX 工作表] 导出与转换：CSV / JSON / Markdown / HTML / 筛选 / 排序 / 合并 / 透视（产出文件）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "输入文件的绝对路径"
          },
          "output": {
            "type": "string",
            "description": "输出目录或文件路径（可选）"
          },
          "op": {
            "type": "string",
            "description": "to_csv | to_json | to_markdown | to_html | filter | sort | merge_sheets | pivot"
          },
          "sheet": {
            "type": "string",
            "description": "工作表名或索引（默认第一张）"
          },
          "header_row": {
            "type": "integer",
            "description": "表头行（默认 1）"
          },
          "query": {
            "type": "string",
            "description": "filter：pandas query 表达式，如 '数值 > 10 and 区域 == \"华东\"'"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "sort/select：列名列表"
          },
          "ascending": {
            "type": "string",
            "description": "sort：是否升序（默认 true）"
          },
          "index": {
            "type": "string",
            "description": "pivot：行索引列"
          },
          "pivot_columns": {
            "type": "string",
            "description": "pivot：列方向字段"
          },
          "values": {
            "type": "string",
            "description": "pivot：聚合值字段"
          },
          "aggfunc": {
            "type": "string",
            "description": "pivot：聚合函数（默认 sum）"
          }
        },
        "required": [
          "input"
        ]
      },
      "_meta": {
        "module": "xlsx",
        "action": "transform"
      }
    },
    {
      "name": "file_xlsx_edit",
      "description": "[XLSX 工作表] 修改工作簿：写单元格/公式、追加行、增删改工作表、设置格式、图表、冻结窗格（会修改输入文件并自动备份）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "输入文件的绝对路径"
          },
          "output": {
            "type": "string",
            "description": "输出目录或文件路径（可选）"
          },
          "op": {
            "type": "string",
            "description": "set_cell | write_range | append_rows | set_formula | add_sheet | delete_sheet | rename_sheet | format_range | autofit | freeze_panes | merge_cells | insert_rows | delete_rows | replace_text | add_chart | set_column_width"
          },
          "sheet": {
            "type": "string",
            "description": "目标工作表（默认第一张）"
          },
          "cell": {
            "type": "string",
            "description": "set_cell / set_formula：单元格坐标，如 B2"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "set_cell：写入值"
          },
          "formula": {
            "type": "string",
            "description": "set_formula：公式，如 =SUM(B2:B10)"
          },
          "range": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array"
              }
            ],
            "description": "write_range / format_range 的区间，如 A1:C10"
          },
          "rows": {
            "anyOf": [
              {
                "type": "array"
              },
              {
                "type": "string"
              }
            ],
            "description": "write_range / append_rows：二维数组"
          },
          "name": {
            "type": "string",
            "description": "add_sheet / rename_sheet 的工作表名"
          },
          "in_place": {
            "type": "boolean",
            "description": "是否就地保存（默认 true）"
          }
        },
        "required": [
          "input"
        ]
      },
      "_meta": {
        "module": "xlsx",
        "action": "edit"
      }
    }
  ]
}
