{
  "package": {
    "name": "综合性办公文件处理技能",
    "slug": "omni-office-file-toolkit",
    "version": "0.1.0",
    "release": "v0.1",
    "release_date": "2026-09-11",
    "skill_standard": "agent-skills",
    "min_python": "3.9",
    "summary": "统一处理 PPTX、DOCX、XLSX、HTML 与图片（含 OCR 图像内容识别）的读取、分析、转换与修改"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "file_docx_probe",
        "description": "[DOCX 文档] ZIP 层快速探测：段落/表格/图片/公式/批注的数量与文档体量",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "deep": {
              "type": "boolean",
              "description": "true 时用 python-docx 补充节与样式信息（默认 false）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_docx_read",
        "description": "[DOCX 文档] 按正文真实顺序读取段落/表格/图片/公式/页眉页脚",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "include_tables": {
              "type": "boolean",
              "description": "是否输出表格数据（默认 true）"
            },
            "include_headers": {
              "type": "boolean",
              "description": "是否输出页眉页脚（默认 true）"
            },
            "include_formulas": {
              "type": "boolean",
              "description": "是否输出 OMML 原始 XML（默认 true）"
            },
            "include_images": {
              "type": "boolean",
              "description": "是否输出图片清单（默认 true）"
            },
            "include_empty": {
              "type": "boolean",
              "description": "是否保留空段落（默认 false）"
            },
            "max_formula_xml": {
              "type": "string",
              "description": "单个公式 XML 最大字符数（默认 4000，超出截断）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_docx_analyze",
        "description": "[DOCX 文档] 文档分析：大纲层级、字数统计、关键词、样式分布、公式/图片、结构问题诊断",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "top_n": {
              "type": "integer",
              "description": "关键词数量（默认 20）"
            },
            "max_heading_level": {
              "type": "string",
              "description": "视为过深的标题层级（默认 4）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_docx_transform",
        "description": "[DOCX 文档] 导出 Markdown / 纯文本 / 图片 / OMML 公式 / HTML / 原始 XML（产出文件）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "to_markdown | to_text | export_images | extract_omml | to_html | dump_xml"
            },
            "formula_as": {
              "type": "string",
              "description": "to_markdown 时公式写法：text（默认，纯文本）或 omml（嵌入原始 XML 注释）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_docx_edit",
        "description": "[DOCX 文档] 修改文档：查找替换（保格式）/追加段落标题/插表格/插入 OMML 公式/清理空段/写属性（会修改输入文件并自动备份）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "replace_text | add_paragraph | append_heading | insert_table | insert_formula | append_markdown | remove_empty_paragraphs | set_core_properties"
            },
            "find": {
              "type": "string",
              "description": "replace_text：查找内容"
            },
            "replace": {
              "type": "string",
              "description": "replace_text：替换内容"
            },
            "regex": {
              "type": "boolean",
              "description": "replace_text：正则模式（默认 false）"
            },
            "text": {
              "type": "string",
              "description": "add_paragraph / append_heading：文本内容"
            },
            "level": {
              "type": "integer",
              "description": "append_heading：标题层级（默认 1）"
            },
            "style": {
              "type": "string",
              "description": "add_paragraph：段落样式名"
            },
            "rows": {
              "anyOf": [
                {
                  "type": "array"
                },
                {
                  "type": "string"
                }
              ],
              "description": "insert_table：二维数组或 CSV 行文本"
            },
            "formula": {
              "type": "string",
              "description": "insert_formula：OMML 片段（含 <m:oMath>）"
            },
            "in_place": {
              "type": "boolean",
              "description": "是否就地保存（默认 true）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_html_probe",
        "description": "[HTML 网页] 快速概览：标题、meta、各类元素数量、内联资源占比",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_html_read",
        "description": "[HTML 网页] 结构化读取：元信息、标题大纲、正文、链接、图片、表格、列表、结构化数据",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "include_text": {
              "type": "boolean",
              "description": "是否输出正文纯文本（默认 true）"
            },
            "main_only": {
              "type": "boolean",
              "description": "只取 article/main 主体内容（默认 false）"
            },
            "include_links": {
              "type": "boolean",
              "description": "输出链接清单（默认 true）"
            },
            "include_images": {
              "type": "boolean",
              "description": "输出图片清单（默认 true）"
            },
            "include_tables": {
              "type": "boolean",
              "description": "输出表格数据（默认 true）"
            },
            "max_text_chars": {
              "type": "string",
              "description": "正文最大字符数（默认 20000）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_html_analyze",
        "description": "[HTML 网页] 质量审查：SEO、无障碍、可读性、外链分布、配色与字号统计、关键词",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "top_n": {
              "type": "integer",
              "description": "关键词数量（默认 20）"
            },
            "main_only": {
              "type": "boolean",
              "description": "只分析主体内容（默认 true）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_html_transform",
        "description": "[HTML 网页] 转换与打包：Markdown / 纯文本 / 自包含单文件 / 抽取 CSS·JS / 净化 / 格式化（产出文件）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "to_markdown | to_text | inline_assets | extract_css | extract_js | extract_tables | sanitize | prettify | minify | rewrite_links"
            },
            "base": {
              "type": "string",
              "description": "rewrite_links：把相对链接改为该基地址"
            },
            "keep_scripts": {
              "type": "boolean",
              "description": "sanitize 时是否保留 <script>（默认 false）"
            },
            "embed_base64": {
              "type": "boolean",
              "description": "inline_assets 是否把图片转为 base64 data URI（默认 true）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_html_edit",
        "description": "[HTML 网页] 修改页面：替换文本/改标题/写 meta/选择器增删改节点/注入 CSS（会修改输入文件并自动备份）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "replace_text | set_title | add_meta | inject_html | remove_elements | set_attribute | add_stylesheet | set_lang"
            },
            "find": {
              "type": "string",
              "description": "replace_text：查找内容（或 CSS 选择器，配合 target=selector）"
            },
            "replace": {
              "type": "string",
              "description": "replace_text：替换内容"
            },
            "target": {
              "type": "string",
              "description": "replace_text：限定在某个选择器内替换"
            },
            "selector": {
              "type": "string",
              "description": "remove_elements / inject_html / set_attribute：CSS 选择器"
            },
            "text": {
              "type": "string",
              "description": "set_title / inject_html：文本或 HTML 片段"
            },
            "position": {
              "type": "string",
              "description": "inject_html：append（默认）| prepend | before | after | body_end | head_end"
            },
            "name": {
              "type": "string",
              "description": "add_meta / set_attribute：属性名"
            },
            "content": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "add_meta / set_attribute：属性值"
            },
            "in_place": {
              "type": "boolean",
              "description": "是否就地保存（默认 true）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_image_probe",
        "description": "[图片（PNG/JPG 等）] 快速探测：格式、尺寸、模式、DPI、透明度、动画、体积",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "exif": {
              "type": "string",
              "description": "是否附带 EXIF 概要（默认 false）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_image_read",
        "description": "[图片（PNG/JPG 等）] 读取元数据：EXIF（含 GPS）、ICC、调色板、质量指标",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "include_exif": {
              "type": "boolean",
              "description": "是否输出完整 EXIF（默认 true）"
            },
            "include_palette": {
              "type": "boolean",
              "description": "是否输出主色板（默认 true）"
            },
            "palette_size": {
              "type": "integer",
              "description": "主色数量（默认 8）"
            },
            "include_metrics": {
              "type": "boolean",
              "description": "是否输出质量指标（默认 true）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_image_analyze",
        "description": "[图片（PNG/JPG 等）] 内容识别：OCR 文字 + 版面还原 + 类型判别 + 视觉桥接载荷",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "ocr": {
              "type": "boolean",
              "description": "是否做 OCR（默认 true；设为 false 则只做统计与判别）"
            },
            "ocr_langs": {
              "type": "string",
              "description": "OCR 语言，默认 chi_sim+eng"
            },
            "ocr_backend": {
              "type": "string",
              "description": "auto / rapidocr / tesseract / easyocr"
            },
            "ocr_min_confidence": {
              "type": "number",
              "description": "过滤低于该置信度的文本块（默认 0.4）"
            },
            "binarize": {
              "type": "boolean",
              "description": "OCR 前是否二值化（默认 false，扫描件可开启）"
            },
            "vision_payload": {
              "type": "boolean",
              "description": "是否输出多模态视觉分析载荷（默认 false，会显著增大响应体）"
            },
            "palette_size": {
              "type": "integer",
              "description": "主色数量（默认 8）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_image_transform",
        "description": "[图片（PNG/JPG 等）] 转换与导出：格式转换、缩放、裁剪、旋转、压缩、水印、转 PDF、base64（产出文件）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "convert | resize | thumbnail | crop | rotate | flip | grayscale | compress | watermark | to_pdf | to_base64 | auto_orient | strip_exif | sprite"
            },
            "format": {
              "type": "string",
              "description": "convert：目标格式 png/jpg/webp/bmp/tiff"
            },
            "width": {
              "type": "integer",
              "description": "resize：目标宽度（像素）"
            },
            "height": {
              "type": "integer",
              "description": "resize：目标高度（像素）"
            },
            "percent": {
              "type": "number",
              "description": "resize/thumbnail：按百分比缩放"
            },
            "keep_aspect": {
              "type": "boolean",
              "description": "resize：是否保持比例（默认 true）"
            },
            "box": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array"
                }
              ],
              "description": "crop/redact：left,top,right,bottom"
            },
            "angle": {
              "type": "integer",
              "description": "rotate：旋转角度（度，逆时针）"
            },
            "quality": {
              "type": "integer",
              "description": "compress：JPEG 质量 1-100（默认 80）"
            },
            "text": {
              "type": "string",
              "description": "watermark：水印文字"
            },
            "max_side": {
              "type": "integer",
              "description": "thumbnail：最长边像素（默认 512）"
            }
          },
          "required": [
            "input"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "file_image_edit",
        "description": "[图片（PNG/JPG 等）] 就地编辑：打码遮盖、模糊/马赛克区域、文字标注、画框、加边框、拼网格（会修改输入文件并自动备份）",
        "parameters": {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "description": "输入文件的绝对路径"
            },
            "output": {
              "type": "string",
              "description": "输出目录或文件路径（可选）"
            },
            "op": {
              "type": "string",
              "description": "redact | blur_region | pixelate_region | annotate_text | draw_box | add_border | draw_grid | watermark"
            },
            "box": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array"
                }
              ],
              "description": "目标区域 left,top,right,bottom（redact/blur/pixelate/draw_box）"
            },
            "text": {
              "type": "string",
              "description": "annotate_text：标注文字；watermark：水印文字"
            },
            "color": {
              "type": "string",
              "description": "draw_box / annotate_text：颜色，如 #FF0000 或 red"
